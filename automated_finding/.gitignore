# Downloaded and converted data — regenerable, potentially large
irw_output/
output_noncore/
downloads/

# Ephemeral batch run state
irw_batch_checkpoint.jsonl
*.log

# Optional local reference file for manual dedup checks (library(irw); write.csv(irw_metadata(), ...)).
# Not read by any script — irw_discover_updated.py fetches exclusions live from
# Google Sheets instead — but harmless to ignore if someone generates it by hand.
irw_metadata.csv

# Discovery-run candidate lists — regenerable from search_terms_log.csv + the
# scripts. Covers both the pre-batch-10 naming (irw_discovered*.csv) and the
# current one (candidates*.csv, e.g. candidates_batch11.csv, candidates_test10.csv,
# candidates_batch14_intl2.csv, candidates_batch13_merged.csv).
irw_discovered*.csv
candidates*.csv

# Triage / retriage outputs — regenerable from the candidate lists via
# irw_batch_updated.py / irw_retriage_ha.py. Includes the historical
# irw_triage_summary*.csv naming and the current irw_triage_batchN.csv /
# irw_retriage_batchN.csv / triage_testN.csv pattern.
# NOTE: human_review_*.csv is deliberately NOT ignored here (2026-08-12) —
# those files now live permanently in human_review/ as the archived record
# of genuinely-ambiguous rows (replacing the old "human eye" queue-sheet
# tab), not a regenerable temp output. See human_review/ and SKILL.md.
irw_triage_summary*.csv
irw_triage*.csv
irw_retriage*.csv
triage_test*.csv

# Scratch / test run outputs
test_*.csv

# irw_discover_pmc.py triage output — regenerable, same lifecycle as the
# candidates*.csv / irw_triage*.csv patterns above.
pmc_triage*.csv
pmc_test*.csv

# journal_scout/ raw API response cache — regenerable (skip-if-exists reruns
# rebuild it), and grows large (~40MB) since it holds one JSON file per
# journal/year/query-variant and per sampled article. The CSVs it feeds
# (journals_resolved.csv, step2_yearly_counts.csv, step3_supp_manifest.csv,
# step4_license.csv, journal_yield.csv, journal_yield_summary.md) are the
# actual deliverables and stay tracked.
journal_scout/cache/

# Python
__pycache__/
*.pyc
