# Data Wrangling
library(tidyverse)
library(dplyr)
library(janitor)

df <- read.csv("pone.0211053.s004.csv")
df <- clean_names(df)

df$id <- seq(1, nrow(df))

df <- df %>%  
  rename(cov_age = "age",
         cov_male = "child_gender_0_female_1_male",
         cov_ADHD = "group_0_control_1_adhd")


# Inattentive criteria symptoms
closeatt <- df %>% 
  select(id, closeatt, starts_with("cov")) %>% 
  pivot_longer(-c(id, starts_with("cov")),
               names_to = "item",
               values_to = "resp") %>% 
  relocate(item, resp, .after = id)

