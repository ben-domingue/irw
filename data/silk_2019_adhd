# Merging symptoms into their criteria
inattentive_criteria <- df %>% 
  select(id, closeatt, susatt, listen, instruct, org, avoid, loses, distract, forget, starts_with("cov")) %>% 
  pivot_longer(-c(id, starts_with("cov")),
               names_to = "item",
               values_to = "resp") %>% 
  relocate(item, resp, .after = id)

hyperactive_impulsive_criteria <- df %>% 
  select(id, fidget, seat, runs, quiet, motor, talks, blurts, turn, interrupt, starts_with("cov")) %>% 
  pivot_longer(-c(id, starts_with("cov")),
               names_to = "item",
               values_to = "resp") %>% 
  relocate(item, resp, .after = id)

